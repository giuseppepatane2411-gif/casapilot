# Crea un progetto Supabase e copia qui i valori della sezione Connect.
NEXT_PUBLIC_SUPABASE_URL=supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo lato server: consente alla route Guimmia di salvare lead e audit IA.
# Usa la nuova Secret key Supabase oppure, nei progetti precedenti, la service_role key.
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solo lato server. Non aggiungere mai NEXT_PUBLIC_ davanti a questa variabile.
OPENAI_API_KEY=sk-your-openai-api-key
